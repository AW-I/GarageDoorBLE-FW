{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP32 OpenOCD",
      "preLaunchTask": "Start Debugger",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}/build",
      "program": "${workspaceFolder}/build/GarageDoorBLE.elf",
      "miDebuggerPath": "C:/Users/Admin/.espressif/tools/xtensa-esp32-elf/esp-2021r2-patch2-8.4.0/xtensa-esp32-elf/bin/xtensa-esp32-elf-gdb.exe",
      "setupCommands": [
          {
              "description": "Target Address",
              "text": "target remote 127.0.0.1:3333",
          },
          {
              "description":  "Breakpoint limit",
              "text": "set remote hardware-watchpoint-limit 2",
          },
          {
            "description":  "Halt",
            "text": "monitor reset halt",
          },
          {
            "description":  "Flush internal register cache",
            "text": "flushregs",
          }
      ]
    }
  ]
}